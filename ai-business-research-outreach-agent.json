{
  "name": "My workflow 2",
  "nodes": [
    {
      "parameters": {
        "promptType": "define",
        "text": "=Evaluate this business as a potential prospect for our AI automation service.\n\nBusiness name: {{ $json.business_name }}\n\nUse the business information available in the input to determine whether it is a realistic potential prospect.\n\nReturn the decision and short reason using the required structured output format.\nIMPORTANT:\nAlways preserve the original business name and client service in your response.\n\nThe output must contain:\n- business_name\n- client_service\n- decision\n- reason",
        "options": {
          "systemMessage": "IMPORTANT DECISION RULE:\n\nYou are evaluating POTENTIAL, not confirmed current processes.\n\nIf you only have a business name or very limited information, do NOT assume the business has no processes that could benefit from AI.\n\nAsk:\n\"Could this type of business reasonably benefit from AI automation?\"\n\nFor businesses such as:\n- clothing/fashion\n- retail/e-commerce\n- restaurants\n- agencies\n- real estate\n- healthcare\n- education\n- professional services\n\nthe answer should generally be YES because they may have opportunities such as customer inquiries, lead qualification, follow-ups, appointments, order handling, FAQs, internal workflows, or data processing.\n\nReturn NO only when the business category genuinely has little realistic opportunity for the service OR the provided information gives strong evidence that automation would not be useful.\n\nNEVER invent facts about the business.\nNEVER say a business has no automatable processes unless the input actually provides evidence for that conclusion.\n\nReturn ONLY:\n\n{\n  \"decision\": \"YES\" or \"NO\",\n  \"reason\": \"Short reason based only on the available information.\"\n}"
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        -288,
        0
      ],
      "id": "74c0d713-22c5-4fd3-8bbe-8487a1f724d9",
