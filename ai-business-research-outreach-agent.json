    {
      "parameters": {
        "promptType": "define",
        "text": "=Write a short, natural cold email to the qualified business.\n\nBusiness name:\n{{ $json.output }}\n\nIMPORTANT:\n- Do NOT invent previous conversations, colleagues, clients, results, statistics, or partnerships.\n- Do NOT claim that our service has helped other businesses unless that information is explicitly provided.\n- Do NOT use placeholders such as [Your Name], [Your Company], or [Contact Information].\n- Do NOT write like a corporate marketing brochure.\n- Keep it conversational and human.\n- Focus on ONE realistic AI automation opportunity.\n- Make the email useful and specific rather than generic.\n- Keep it around 80–120 words.\n- End with a simple, low-pressure question.\nIMPORTANT OUTPUT FORMAT:\nReturn ONLY valid JSON. No markdown, no code block, no explanation.\n\n{\n  \"subject\": \"Short email subject\",\n  \"body\": \"Hi/Hello ...\\n\\nShort personalized body...\\n\\nBest,\\nSender name\"\n}",
        "options": {
          "systemMessage": "You are a professional cold-email writer.\n\nWrite a short, personalized cold email for a business that has been identified as a potential fit for the client's service.\n\nDo not exaggerate or make unsupported claims.\nKeep the email natural, specific, and concise."
        }
      },
